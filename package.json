{
  "name": "sara-self-bot",
  "version": "1.0.0",
  "description": "🌸 SARA AI - ربات شخصیت سارا برای Cloudflare Workers",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "tail": "wrangler tail",
    "setup": "wrangler deploy && curl -X GET https://sara-self-bot.workers.dev/setup",
    "logs": "wrangler tail --format=pretty",
    "kv:list": "wrangler kv:key list --binding=KV",
    "kv:clear": "wrangler kv:key delete --binding=KV --prefix=user:"
  },
  "keywords": [
    "telegram-bot",
    "cloudflare-workers",
    "ai",
    "persian",
    "chatbot"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
